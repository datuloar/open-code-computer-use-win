{
  "name": "dsh-cu",
  "version": "1.4.0",
  "description": "Windows desktop tools for OpenCode: UI Automation, OCR, screenshots and gated mouse/keyboard input with a visible ESC indicator.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./opencode": "./opencode/plugin.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-cu": "src/cli.js"
  },
  "files": [
    "lib",
    "src",
    "backends",
    "bin",
    "packaging",
    "package-opencode.ps1",
    "docs",
    "install.ps1",
    "install-opencode.ps1",
    "install-vision.ps1",
    "opencode",
    "SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.8 <0.2.0 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "gui-automation",
    "automation",
    "screenshot",
    "sendinput",
    "windows",
    "skill",
    "opencode",
    "mcp"
  ],
  "license": "MIT",
  "author": "dsh-computer-use contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datuloar/open-code-computer-use-win.git"
  },
  "homepage": "https://github.com/datuloar/open-code-computer-use-win#readme",
  "bugs": {
    "url": "https://github.com/datuloar/open-code-computer-use-win/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.8 <0.2.0 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1"
  },
  "private": true
}
