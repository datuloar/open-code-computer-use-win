{
  "name": "opencode-computer-use",
  "version": "1.0.0",
  "description": "Windows desktop tools for OpenCode: UI Automation, OCR, screenshots and gated mouse/keyboard input with a visible ESC indicator.",
  "type": "module",
  "main": "opencode/plugin.js",
  "exports": {
    ".": "./opencode/plugin.js",
    "./mcp": "./opencode/mcp.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "opencode-cu": "src/cli.js"
  },
  "files": [
    "src",
    "backends",
    "bin",
    "packaging",
    "package-opencode.ps1",
    "docs",
